# Google Sheets Apps Script Web App URL
# Obtain this by deploying google-apps-script/Code.gs as a Web App:
# Deploy -> New Deployment -> Select 'Web App' -> Execute as: Me, Who has access: Anyone
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Site Password Protection
# Protects the entire application with an access password.
# Set a single password:
SITE_PASSWORD=admin123

# Or configure multiple passwords for different team members (comma-separated):
# SITE_PASSWORDS=admin123, team2026, manager@secure
